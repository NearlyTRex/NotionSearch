# Copy to .env to customise. Every value has a working default.

# Port the web UI listens on (http://localhost:PORT)
PORT=8080

# Leave blank for no login prompt (fine on a personal machine).
# Set a password to require sign-in before searching.
APP_PASSWORD=

# Internal search engine key. Change it if you like; it never leaves this machine.
MEILI_MASTER_KEY=notionsearch_local_key_change_me

LOG_LEVEL=INFO

# Who the container runs as. Normally leave these unset: the container adopts
# whoever owns the ./data folder, so files stay owned by you (backups work
# without sudo) on any machine. Set them only to force a specific user.
# Check yours with: id -u && id -g
#PUID=1000
#PGID=1000
